char *res_path(char *cmd, char **env, int line)
{
	char *pathing = NULL;
	char *path_env = NULL;
	int i;

	for (i = 0; env[i]; i++)
	{
		if (strncmp(env[i], "PATH=", 5) == 0)
		{
			path_env = env[i] + 5;
			break;
		}
	}
	if (!path_env || path_env[0] == '\0')
	{
		fprintf(stderr, "./hsh: %d: %s: not found\n", line, args[0]);
		return (127);
	}
	pathing = _path(args[0], env);
	if (!pathing)
	{
		fprintf(stderr, "./hsh: %d: %s: not found\n", line,  args[0]);
		return (127);
	}
return (pathing);
}
